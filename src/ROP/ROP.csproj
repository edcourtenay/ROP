<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EdCourtenay.ROP</PackageId>
    <Description>A C# library for composing operations that can succeed or fail, inspired by Railway Oriented Programming.</Description>
    <PackageTags>railway;railway-oriented-programming;result;functional;either;rop</PackageTags>
    <Authors>Ed Courtenay</Authors>
    <PackageProjectUrl>https://github.com/edcourtenay/ROP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/edcourtenay/ROP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ROP.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <AssemblyName>EdCourtenay.ROP</AssemblyName>
    <RootNamespace>EdCourtenay.ROP</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="ROP.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="all" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- The analyzer is referenced as an analyzer by every project (see Directory.Build.targets). Its
       output path is resolved directly so renaming the analyzer assembly cannot silently drop it. -->
  <Target Name="_IncludeAnalyzerInPackage" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ROP.Analyzers\ROP.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerAssemblyPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnalyzerAssemblyPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
